{
  "name": "dsh-nexus-usage-panel",
  "description": "Nexus usage dashboard panel for the DSH Web GUI: mirrors the Fireworks Nexus desktop app's Overview card (plan tier, monthly % used, 5-hour session % used, reset times) by reading the same private nexusPlans/nexusPlanUsage REST API with the machine's keychain key.",
  "version": "0.1.1",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/host-usage.mjs && node test/client-smoke.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "external": [
        "react",
        "react/jsx-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": ">=0.1.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings-general": ">=0.1.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-invariants": ">=0.1.1-rc.2 <0.3.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT"
}
